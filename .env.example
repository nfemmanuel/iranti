# Copy this file to .env and fill in your values.
# Never commit .env — it is gitignored.

# PostgreSQL connection string.
# For local development, matches the docker-compose.yml defaults.
# Port 5435 is used to avoid conflicts with any native PostgreSQL installation on 5432.
DATABASE_URL=postgresql://iranti:iranti_dev@localhost:5435/iranti_dev

# CORE-16: semantic retrieval tier (embeddings, bottom rung — subordinate to
# exact/keyword; see docs/prds/phases/core-16-semantic-retrieval.md). Off by
# default (zero-infra core). Set to "ollama" to enable, with Ollama running
# locally and IRANTI_EMBED_MODEL pulled (`ollama pull nomic-embed-text`).
IRANTI_EMBEDDER=off
# IRANTI_EMBED_MODEL=nomic-embed-text
# IRANTI_EMBED_ENDPOINT=http://localhost:11434
