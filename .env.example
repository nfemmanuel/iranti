# Copy this file to .env and fill in your values.
# Never commit .env — it is gitignored.

# PostgreSQL connection string.
# For local development, matches the docker-compose.yml defaults.
# Port 5435 is used to avoid conflicts with any native PostgreSQL installation on 5432.
DATABASE_URL=postgresql://iranti:iranti_dev@localhost:5435/iranti_dev

# Semantic retrieval / recall tier (embeddings).
#   CORE-16 = semantic slot-fill over facts; CORE-17 = retrieval-first recall
#   over raw chunks. See docs/prds/phases/core-16-semantic-retrieval.md and
#   docs/prds/phases/core-17-retrieval-first-recall.md.
#
# DEFAULT (leave this UNSET): auto-ON-when-reachable (CORE-17 §9). At startup
# iranti runs a bounded, fail-closed probe of the Ollama endpoint below; if it
# is up and the embed model responds, the recall tier turns ON automatically.
# On a machine without Ollama it degrades SILENTLY to deterministic-only recall
# (today's zero-infra behavior — no crash, no hang). Local Ollama is the default
# runtime (OD-2), so recall is on out-of-the-box in the standard setup.
#
# To force it OFF regardless of reachability (opt-out — always wins over the
# probe), set IRANTI_EMBEDDER=off. To force a specific backend, set "ollama"
# (skips the probe; assumes reachable) or "mock" (test-only).
#   ollama pull nomic-embed-text   # the default embed model
# IRANTI_EMBEDDER=off
# IRANTI_EMBED_MODEL=nomic-embed-text
# IRANTI_EMBED_ENDPOINT=http://localhost:11434
